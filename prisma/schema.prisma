generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  // Strip extensions from generated imports so the Next.js bundler resolves them.
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

/// A family, and the unit everything is scoped to.
///
/// The app began as one household with the scoping left implicit - a single
/// plan, a single pantry, one row per meal slot in the entire database. This
/// model makes that unit explicit so a second family can use the app without
/// fighting the first for Tuesday dinner.
model Household {
  id        String   @id @default(cuid())
  /// Shown in the nav and on the household page. "The McMullens".
  name      String
  createdAt DateTime @default(now())

  members  User[]
  invites  Invite[]
  recipes  Recipe[]
  meals    PlannedMeal[]
  pantry   PantryItem[]
  skips    WeeklySkip[]
  handoffs ShoppingHandoff[]

  @@map("household")
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  /// E.164, or null for somebody who has not given one.
  ///
  /// Optional because it only buys one thing - having the week's shopping
  /// texted to you - and an account is perfectly usable without it. Not unique:
  /// a household sharing one handset is odd but not wrong, and a unique index
  /// would turn that into an error message nobody could act on.
  phone         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  /// Which family this login belongs to. Exactly one - several logins share a
  /// household, not the reverse.
  ///
  /// Nullable only because better-auth's Prisma adapter inserts the user row
  /// itself and knows nothing about this column. The signup hook assigns a
  /// household immediately afterwards and deletes the account if it cannot, so
  /// a persisted user without one is not a state the app produces. Read it
  /// through `requireHousehold()` rather than trusting it here.
  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  recipes      Recipe[]
  invitesSent  Invite[]          @relation("InviteSender")
  inviteUsed   Invite?           @relation("InviteRedeemer")
  shoppingRuns ShoppingHandoff[]
  pantryItems  PantryItem[]
  weeklySkips  WeeklySkip[]
  reviews      RecipeReview[]

  @@unique([email])
  @@index([householdId])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  /// Namespaces accountId so a provider ID cannot collide with a local
  /// credential. Required by better-auth >= 1.5; the deprecated CLI that
  /// generated these models predates it.
  issuer                String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@index([issuer, accountId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Access control
// ---------------------------------------------------------------------------

/// Signup is closed. An existing user mints an invite; the recipient redeems
/// the code to create the only account that code will ever create.
///
/// The invite also decides which family the new account lands in, which is what
/// separates the two kinds of invitation: one into your own household, one to
/// someone outside it who gets a household of their own.
model Invite {
  id         String    @id @default(cuid())
  code       String    @unique
  /// Optional: pins the invite to one address so a leaked code is still useless.
  email      String?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  redeemedAt DateTime?

  /// The household this code joins. Null means the redeemer gets a brand new
  /// household of their own - an invitation to use the app, not to join the
  /// family. Encoded as the presence of a household rather than a separate
  /// kind flag, so the two can never disagree.
  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)

  /// What to call the household this code will create, chosen by whoever sent
  /// it. Only meaningful when `householdId` is null. Null falls back to a name
  /// derived from the redeemer, which is the right answer when the sender did
  /// not know what the family calls itself.
  householdName String?

  createdById String
  createdBy   User   @relation("InviteSender", fields: [createdById], references: [id], onDelete: Cascade)

  /// Set when redeemed. Unique, so one invite can never mint two accounts.
  redeemedById String? @unique
  redeemedBy   User?   @relation("InviteRedeemer", fields: [redeemedById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@index([householdId])
  @@map("invite")
}

// ---------------------------------------------------------------------------
// Recipes
// ---------------------------------------------------------------------------

/// How a recipe got into the library. Extracted recipes carry their source PDF.
/// Oven temperatures are stored in the unit the card printed them in.
/// Converting on the way in would turn a clean 180C into 356F, and the cook
/// reading the card wants to see the number they can dial.
enum TemperatureUnit {
  FAHRENHEIT
  CELSIUS
}

enum RecipeSource {
  MANUAL
  PDF
}

model Recipe {
  id           String       @id @default(cuid())
  title        String
  description  String?
  servings     Int          @default(4)
  prepMinutes  Int?
  cookMinutes  Int?
  sourceUrl    String?
  /// Where it came from, by name: "Bon Appetit", "Nana's card". A URL is not
  /// always available, and often the provenance is the point.
  sourceName   String?
  /// Ordered preparation steps.
  instructions String[]     @default([])
  notes        String?
  source       RecipeSource @default(MANUAL)

  /// Oven temperature as printed, with the unit it was printed in. Either both
  /// are set or neither is - a number with no unit is not a temperature, and
  /// the migration has a CHECK constraint saying so.
  ovenTemp     Int?
  ovenTempUnit TemperatureUnit?
  /// Resting, chilling, marinating, proving. Kept apart from cook time because
  /// it changes when you have to start, not how long you stand at the stove -
  /// which is exactly what a weeknight plan needs to know.
  restMinutes  Int?
  /// "Makes 12 muffins", "Serves 4 as a main, 6 as a starter". The integer
  /// servings drives the shopping maths; this says what the card said.
  yieldNote    String?
  /// "9x13 pan", "Dutch oven", "Stand mixer". Worth knowing before you start
  /// rather than at step four.
  equipment    String[]         @default([])

  /// Blob URLs. Both optional: the dish photo especially is best-effort, since
  /// not every PDF contains one.
  pdfUrl      String?
  pdfFilename String?
  /// SHA-256 of the uploaded PDF's bytes, so the same file is recognised on a
  /// second upload. Unique, and null for recipes typed in by hand - Postgres
  /// treats NULLs as distinct, so any number of manual recipes coexist while
  /// one PDF can only ever produce one recipe.
  /// Unique across the whole library, because the library is shared: if
  /// somebody has already uploaded this exact card, the recipe is there for
  /// everyone and a second copy is noise rather than a second dish.
  pdfSha256   String? @unique
  imageUrl    String?

  /// Which family added this, not who is allowed to read it.
  ///
  /// The library is shared: every signed-in household sees, searches, plans
  /// and reviews every recipe, which is what makes the star averages worth
  /// anything at this size. This column only decides who may change a recipe
  /// or take it away again, so one family cannot delete another's cards out
  /// of a library they both rely on.
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ingredients  Ingredient[]
  tags         RecipeTag[]
  plannedMeals PlannedMeal[]
  reviews      RecipeReview[]

  /// Maintained by a trigger (see the recipe_search migration), not by Prisma.
  /// Declared here only so migrations do not drop a column they cannot model.
  /// Prisma Client cannot select Unsupported columns; search runs as raw SQL.
  searchVector Unsupported("tsvector")? @map("search_vector")

  @@index([householdId])
  @@index([createdById])
  @@index([createdAt])
  @@index([searchVector], type: Gin)
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("recipe")
}

model Ingredient {
  id       String  @id @default(cuid())
  recipeId String
  name     String
  /// Nullable so "salt to taste" is representable without inventing an amount.
  quantity Float?
  unit     String?
  note     String?
  position Int     @default(0)

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([recipeId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("ingredient")
}

model Tag {
  id        String      @id @default(cuid())
  /// Display form, e.g. "Sheet Pan".
  name      String      @unique
  /// Lookup form, e.g. "sheet-pan".
  slug      String      @unique
  createdAt DateTime    @default(now())
  recipes   RecipeTag[]

  @@map("tag")
}

model RecipeTag {
  recipeId String
  tagId    String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([recipeId, tagId])
  @@index([tagId])
  @@map("recipe_tag")
}

// ---------------------------------------------------------------------------
// Weekly planning
// ---------------------------------------------------------------------------

/// One person's verdict on one recipe: a score, and optionally what they
/// thought.
///
/// Stars and words are one record rather than two. A five-star score with no
/// explanation is worth less than "five stars, but halve the chilli", and a
/// note from someone who never said whether they liked the dish leaves the
/// reader guessing. Tying them together means every opinion carries a score
/// and every score can carry its reasoning.
///
/// One review per person per recipe, so the average reflects how many people
/// liked a dish rather than how many times its keenest fan said so. Cooking it
/// again and changing your mind edits the review you already left.
model RecipeReview {
  id    String  @id @default(cuid())
  /// Whole stars, 1 to 5. Required - a review with no score is a note, and the
  /// range is enforced by a CHECK constraint in the migration as well as here,
  /// because an average is only meaningful if nothing off the scale can reach
  /// the column.
  stars Int
  /// What they thought. Optional, so rating a dish stays a two-second job for
  /// anyone with nothing to add.
  body  String?

  recipeId String
  recipe   Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recipeId, userId])
  @@index([recipeId, createdAt])
  @@index([userId])
  @@map("recipe_review")
}

enum MealSlot {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

/// One shared plan per household rather than a plan per user - the whole point
/// is that everyone in the family is looking at the same week.
model PlannedMeal {
  id   String   @id @default(cuid())
  /// Midnight UTC on the day the meal is planned for.
  date DateTime @db.Date
  slot MealSlot

  /// Either points at a saved recipe or carries a one-off title ("leftovers").
  recipeId    String?
  customTitle String?
  servings    Int      @default(4)
  createdAt   DateTime @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  recipe Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@unique([householdId, date, slot])
  @@index([householdId, date])
  @@map("planned_meal")
}

/// How long an ingredient stays off the shopping list.
/// A staple the household always has in: salt, olive oil, flour.
///
/// The point of the pantry is that these never reach a shopping list. Keeping
/// them in their own table rather than as a flavour of "skip" means they can be
/// managed as a list in their own right - added before they ever show up on a
/// week's shopping, rather than only dismissed after they do.
model PantryItem {
  id             String   @id @default(cuid())
  /// As typed, for display.
  name           String
  /// Lower-cased and trimmed, for matching against recipe ingredients. Unique
  /// within the household: a pantry with "Olive Oil" and "olive oil" in it is
  /// a bug, but two families both keeping olive oil in is the normal case.
  normalisedName String
  createdAt      DateTime @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([householdId, normalisedName])
  @@index([createdById])
  @@map("pantry_item")
}

/// "We already have milk, do not put it on this week's list."
///
/// Distinct from the pantry: this expires. Next week milk is back on the list,
/// which is what you want for something you ran out of rather than something
/// you always keep.
model WeeklySkip {
  id             String   @id @default(cuid())
  name           String
  normalisedName String
  weekStart      DateTime @db.Date
  createdAt      DateTime @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@unique([householdId, normalisedName, weekStart])
  @@index([createdById])
  @@map("weekly_skip")
}

enum ShoppingProvider {
  INSTACART
  AMAZON_FRESH
  WHOLE_FOODS
}

/// A record of each list handed off to a shop. Checkout happens on their side,
/// so this is the last thing we know about an order.
model ShoppingHandoff {
  id        String           @id @default(cuid())
  provider  ShoppingProvider
  weekStart DateTime         @db.Date
  /// The prepared cart, for providers that build one. Null for deep-link
  /// providers, where there is no single URL representing the whole list.
  url       String?
  itemCount Int
  createdAt DateTime         @default(now())

  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([householdId, weekStart])
  @@index([createdById])
  @@map("shopping_handoff")
}
