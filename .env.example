# --- Database -------------------------------------------------------------
# Local dev: a Postgres instance you control.
# Production: the Neon pooled connection string.
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/mealmagic"

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Recipe extraction ----------------------------------------------------
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=""

# --- Instacart ------------------------------------------------------------
# Development keys work immediately; production keys require Instacart review.
INSTACART_API_KEY=""
INSTACART_API_BASE="https://connect.dev.instacart.tools"

# --- File storage ---------------------------------------------------------
# Unset locally: uploads fall back to ./.uploads on disk.
# On Vercel this is injected automatically when a Blob store is attached.
BLOB_READ_WRITE_TOKEN=""
